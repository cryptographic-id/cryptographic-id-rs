#!/usr/bin/bash
DIR="/etc/cryptographic_id/initramfs"
TMPDIR=
TMPKEY=
NL='
'
PARENT_ATTR="fixedtpm|fixedparent|sensitivedataorigin|restricted|decrypt"
OBJECT_ATTR="fixedtpm|fixedparent|sensitivedataorigin|noda|sign"

help() {
	cat << EOF
Create identity in the initramfs directory. (Rebuild it to include new keys.)
Add a unencrypted identity:
	${0} insecure NAME
Add a age-encrypted identity
	${0} insecure-age NAME
Add an identity stored in a tpm2
	${0} tpm2 NAME [--handle-only]
		--handle-only: dont store sensitive portion of the tpm2-object
		               private-key is lost, if handle gets removed
		               from the tpm2.
EOF
}
cleanup() {
	umount "${TMPDIR}"
	rm -rf "${TMPDIR}"
}
create_tmpdir() {
	trap cleanup EXIT
	TMPDIR="$(mktemp -d || exit 1)"
	mount -t tmpfs tmpfs "${TMPDIR}"
	chmod 700 "${TMPDIR}"
}
create_tmpkey() {
	create_tmpdir
	TMPKEY="${TMPDIR}/id"
	cryptographic_id create "${TMPKEY}"
	cryptographic_id show "${TMPKEY}"
}
create_policy_session() {
	local policy="${1}"
	local pcrs="${2}"
	tpm2_startauthsession -S session.ctx --policy-session
	tpm2_policypassword -S session.ctx -L "${policy}" --quiet
	if [ "${pcrs}" != "" ]; then
		tpm2_policypcr \
			--quiet \
			--policy "${policy}" \
			--session session.ctx \
			--pcr-list "sha256:${pcrs}"
	fi
}
cleanup_policy_session() {
	tpm2_flushcontext session.ctx
	rm -f session.ctx
}
umask 0077
case "${1}" in
insecure)
	key="${DIR}/insecure/${2}"
	printf "Create key: %s\\n" "${key}"
	cryptographic_id create "${key}"
	cryptographic_id show "${key}"
	chmod 400 "${key}"
;;
insecure-age)
	key="${DIR}/age/${2}"
	printf "Create key: %s\\n" "${key}"
	create_tmpkey
	age -p -o "${key}" "${TMPKEY}"
	chmod 400 "${key}"
;;
tpm2)
	create_tmpdir
	key="${DIR}/tpm2/${2}"
	privdir="${key}"
	case "${3}" in
	"--handle-only")
		privdir="${TMPDIR}"
	;;
	"")
		true
	;;
	*)
		printf "Unknown parameter: %s\\n" "${3}"
		exit 1
	;;
	esac
	mkdir -p "${key}"
	cd "${TMPDIR}" || exit 1
	policy="policy.ctx"
	printf "Use PCRs? (empty for none or list of pcrs, e.g. 1,7) "
	read -r pcrs
	printf "Enter password (empty for no-password): "
	read -r -s password
	if [ "${password}" != "" ]; then
		printf "\\nEnter password again: "
		read -r -s password2
		if [ "${password}" != "${password2}" ]; then
			printf "\\nPasswords do not match\\n"
			exit 1
		fi
		printf "" > "${key}/password"
	fi
	printf "\\n"
	create_policy_session "${policy}" "${pcrs}"
	if [ "${pcrs}" != "" ]; then
		printf "%s" "${pcrs}" > "${key}/pcrs"
	fi
	policy_val="$(tpm2_getpolicydigest -S session.ctx --hex)"
	tpm2_createprimary \
		--quiet \
		--hierarchy e \
		--hash-algorithm sha256 \
		--key-algorithm ecc256 \
		--key-context primary.ctx \
		--key-auth "${password}" \
		--policy "${policy_val}" \
		--attributes "${PARENT_ATTR}"
	tpm2_create \
		--quiet \
		--key-algorithm ecc256 \
		--hash-algorithm sha256 \
		--public "${privdir}/ecc.pub" \
		--private "${privdir}/ecc.priv" \
		--parent-context primary.ctx \
		--parent-auth "session:session.ctx+${password}" \
		--key-auth "${password}" \
		--policy "${policy_val}" \
		--format pem \
		--output "${key}/public_key.pem" \
		--attributes "${OBJECT_ATTR}"
	cleanup_policy_session
	printf 2 > "${key}/version"
	if [ "${3}" = "--handle-only" ]; then
		create_policy_session "${policy}" "${pcrs}"
		tpm2_load \
			--quiet \
			--parent-context primary.ctx \
			--auth "session:session.ctx+${password}" \
			--public "${privdir}/ecc.pub" \
			--private "${privdir}/ecc.priv" \
			--key-context ecc.ctx
		tpm2_evictcontrol \
			--quiet \
			--object-context ecc.ctx \
			--output "${key}/handle"
		cleanup_policy_session
	fi
	openssl ec -outform der \
		-pubin -in "${key}/public_key.pem" \
		-pubout -out "${key}/public_key.der" > /dev/null
	dd if="${key}/public_key.der" of="${key}/public_key.raw" \
		bs=1 skip=26 count=65 status=none
	hash="$(dd if="${key}/public_key.raw" bs=1 skip=1 | \
		openssl dgst -sha256 -c --hex | \
		tr '[:lower:]' '[:upper:]')"
	printf "%s\\n\\n" "${hash}"
	printf "Fingerprint:\\n"
	printf "%s\\n" "${hash}" | \
		cut -c 18-40,42-64,66-88,90-113 --output-delimiter "${NL}"
	cd / || exit 1
	chmod 400 "${key}"/*
;;
*)
	help
;;
esac
