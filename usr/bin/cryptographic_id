#!/usr/bin/sh
ADD_FILE_OPTION="BindPaths"
ADD_FILE="/dev/null"
ENV_FILE="/etc/cryptographic_id/initramfs/config"
use_rw_file() {
	file="$(realpath "${1}")"
	touch "${file}"
	if [ ! -d "${file}" ] && [ ! -f "${file}" ]; then
		printf "%s is not a file or directory\\n" "${file}"
		exit 1
	fi
	ADD_FILE="${file}"
}
use_ro_file() {
	use_rw_file "${1}"
	ADD_FILE_OPTION="BindReadOnlyPaths"
}
if [ ! -r "${ENV_FILE}" ]; then
	ENV_FILE="/dev/null"
fi
run_cmd() {
	/usr/bin/systemd-run --user --quiet --pty \
		--setenv PASSWORD \
		-p "TemporaryFileSystem=/:rw" \
		-p "BindReadOnlyPaths=/usr" \
		-p "BindReadOnlyPaths=/lib" \
		-p "BindReadOnlyPaths=/lib64" \
		-p "${ADD_FILE_OPTION}=${ADD_FILE}" \
		-p "BindPaths=-/dev/tpmrm0" \
		-p "DeviceAllow=/dev/tpmrm0" \
		-p "BindPaths=-/dev/video0" \
		-p "DeviceAllow=/dev/video0" \
		-p "EnvironmentFile=${ENV_FILE}" \
		-p "AmbientCapabilities=" \
		-p "CapabilityBoundingSet=" \
		-p "DevicePolicy=closed" \
		-p "IPAddressDeny=any" \
		-p "LockPersonality=true" \
		-p "MemoryDenyWriteExecute=true" \
		-p "NoNewPrivileges=true" \
		-p "PrivateDevices=true" \
		-p "PrivateIPC=true" \
		-p "PrivateNetwork=true" \
		-p "PrivateTmp=true" \
		-p "PrivateUsers=true" \
		-p "ProcSubset=pid" \
		-p "ProtectClock=true" \
		-p "ProtectControlGroups=true" \
		-p "ProtectHostname=true" \
		-p "ProtectKernelLogs=true" \
		-p "ProtectKernelModules=true" \
		-p "ProtectKernelTunables=true" \
		-p "ProtectProc=invisible" \
		-p "ProtectSystem=strict" \
		-p "RemoveIPC=true" \
		-p "RestrictAddressFamilies=" \
		-p "RestrictNamespaces=true" \
		-p "RestrictRealtime=true" \
		-p "RestrictSUIDSGID=true" \
		-p "SystemCallArchitectures=native" \
		-p "SystemCallFilter=~@clock" \
		-p "SystemCallFilter=~@cpu-emulation" \
		-p "SystemCallFilter=~@debug" \
		-p "SystemCallFilter=~@module" \
		-p "SystemCallFilter=~@mount" \
		-p "SystemCallFilter=~@obsolete" \
		-p "SystemCallFilter=~@privileged" \
		-p "SystemCallFilter=~@raw-io" \
		-p "SystemCallFilter=~@reboot" \
		-p "SystemCallFilter=~@resources" \
		-p "SystemCallFilter=~@swap" \
		-p "UMask=0077" \
		/usr/lib/cryptographic_id/cryptographic-id-rs "${@}"
}
case "${1}" in
create)
	use_rw_file "${2}"
	if [ ! -f "${ADD_FILE}" ]; then
		printf "%s is not a file\\n" "${ADD_FILE}"
		exit 1
	fi
	run_cmd "${1}" "${ADD_FILE}"
;;
show)
	use_ro_file "${2}"
	run_cmd "${1}" "${ADD_FILE}"
;;
sign)
	use_ro_file "${2}"
	run_cmd "${1}" "${ADD_FILE}" "${3}"
;;
*)
	run_cmd "${@}"
;;
esac
