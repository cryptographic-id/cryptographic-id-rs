#!/usr/bin/sh
DIR="${1}"
TMPDIR="/tmp/cryptographic_id"
TMPKEY="${TMPDIR}/key"
TMPFONT="/tmp/cryptographic_id.font"
TTY_SETTINGS="$(stty -g)" || exit 1
INPUT_PASSWORD=""

set_custom_font() {
	if [ "${FONT}" != "" ]; then
		if [ -f "${TMPFONT}" ]; then
			setfont "${FONT}"
		else
			setfont "${FONT}" -O "${TMPFONT}"
		fi
	fi
}

cat_identity() {
	[ ! -f "${1}" ] && return 1
	cp "${1}" "${TMPKEY}"
}

age_decrypt_identity() {
	[ ! -f "${1}" ] && return 1
	printf "Key: %s:\\n" "${1}"
	for _ in 1 2 3; do
		age -d -o "${TMPKEY}" "${1}" && return
	done
}

run_binary() {
	/usr/lib/cryptographic_id/cryptographic-id-rs "${@}"
}

tpm2_identity() {
	[ ! -d "${1}" ] && return 1
	cp "${1}/public_key.raw" "${TMPKEY}"
}

read_password() {
	printf "Enter password (blank to use previous): "
	stty -echo || exit 1
	read -r INPUT_PASSWORD
	stty echo || exit 1
	printf "\\n"
}

show_identities() {
	res=""
	last_password=""
	get_key="${2}"
	for file in "${DIR}/${1}/"*; do
		"${get_key}" "${file}" || continue
		if [ ! -f "${TMPKEY}" ]; then
			printf "Key does not exist\\n"
			continue
		fi
		res=""
		while [ "${res}" != "y" ]; do
			# Move old qrcode out of screen, so scanning is easier
			printf "\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n"
			printf "\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n"
			printf "Key: %s:\\n" "${file}"
			use_password=""
			if [ -f "${file}/password" ]; then
				read_password
				if [ "${INPUT_PASSWORD}" = "" ]; then
					use_password="${last_password}"
				else
					use_password="${INPUT_PASSWORD}"
					last_password="${INPUT_PASSWORD}"
				fi
			fi
			printf "\\nEnter message to sign: "
			read -r msg
			# set custom font each iteration, to prevent problems
			# when udev set it to something different
			set_custom_font
			date '+%Y-%m-%d %H:%M:%S'
			PASSWORD="${use_password}" run_binary sign "${file}" "${msg}"
			printf "\\nContinue (y) or create new qr-code (q)? "
			read -r res
			printf "\\n"
		done
		rm -f "${TMPKEY}"
	done
}

scan_and_measure() {
	res=""
	while [ "${res}" != "y" ]; do
		run_binary scan_and_measure
		printf "\\nContinue (y) or scan another id (s)? "
		read -r res
		printf "\\n"
	done
}

cleanup() {
	if [ -f "${TMPFONT}" ]; then
		setfont "${TMPFONT}"
	fi
	rm -f "${TMPDIR}"/*
	stty "${TTY_SETTINGS}"
}

main() {
	trap cleanup EXIT
	mkdir -m 0700 "${TMPDIR}"
	show_identities "insecure" cat_identity
	show_identities "tpm2" tpm2_identity
	show_identities "age" age_decrypt_identity
	if [ "${EXTEND_PCR}" != "" ]; then
		scan_and_measure
	fi
}

main
